# Polis Environment Variables
# Copy this file to .env.local and fill in the values needed for local development.

# Convex
# Created by `npx convex dev` after configuring a Convex project.
CONVEX_DEPLOYMENT=""
NEXT_PUBLIC_CONVEX_URL=""

# Clerk (https://dashboard.clerk.com)
# Create a Clerk application, then copy the keys from the API Keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Clerk JWT issuer domain for Convex auth validation.
# Typically "https://your-clerk-instance.clerk.accounts.dev" (found in Clerk dashboard > JWT Verifiers).
CLERK_JWT_ISSUER_DOMAIN=""

# Clerk + Convex: In the Clerk dashboard, create a JWT template named "convex" with:
#   - Issuer: set to your CLERK_JWT_ISSUER_DOMAIN
#   - Audience: "convex"
#   - Claims: default (sub, name, email, picture) are sufficient
# Then in the Convex dashboard, verify auth config points to the Clerk issuer domain.

# Runtime AI providers are intentionally not wired during this migration.
# They will be added after the Convex data/auth foundation is in place.
