# SocialSciencr Environment Variables
# Copy this file to .env and fill in the values

# Database - PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialsciencr?schema=public"

# Auth.js - Generate with: npx auth secret
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# GitHub OAuth (optional - for GitHub login)
# GITHUB_ID=""
# GITHUB_SECRET=""

# Google OAuth (optional - for Google login)
# GOOGLE_ID=""
# GOOGLE_SECRET=""

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# AI Provider Configuration
# Which provider to use: "openai" (default) or "anthropic"
AI_PROVIDER="openai"
# Default model for chat completions
AI_MODEL="gpt-4o-mini"
# Embedding model for vector search
EMBEDDING_MODEL="text-embedding-3-small"

# API Keys (at least one required for AI features)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Encryption key for user API keys (generate a random 32-byte hex string)
ENCRYPTION_KEY="change-me-to-a-random-32-byte-hex-string"
