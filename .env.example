# SocialSciencr Environment Variables
# Copy this file to .env.local and fill in the values.

# Convex
CONVEX_DEPLOYMENT=""
NEXT_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"
# Optional but recommended. Set the same value in Convex env and Next env.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONVEX_SERVER_SECRET=""

# Better Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="change-me-to-a-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth (optional)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_ID=""
GOOGLE_SECRET=""
NEXT_PUBLIC_GITHUB_ENABLED="false"
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# AI Provider Configuration
# Which provider to use: "openai" (default), "anthropic", or "google"
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Server-level API keys are optional if users connect their own keys in Settings.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# Encryption key for user API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="change-me-to-a-random-32-byte-hex-string"

# Rate Limiting (AI API calls)
AI_RATE_LIMIT_REQUESTS=50
AI_RATE_LIMIT_TOKENS=500000
