# Polis Environment Variables
# Copy this file to .env.local and fill in the values needed for local development.

# Convex
# Created by `npx convex dev` after configuring a Convex project.
CONVEX_DEPLOYMENT=""
NEXT_PUBLIC_CONVEX_URL=""

# Clerk (https://dashboard.clerk.com)
# Create a Clerk application, then copy the keys from the API Keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Clerk JWT issuer domain for Convex auth validation.
# Typically "https://your-clerk-instance.clerk.accounts.dev" (found in Clerk dashboard > JWT Verifiers).
CLERK_JWT_ISSUER_DOMAIN=""

# Clerk URLs (found in Clerk dashboard > Paths)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL="/"
NEXT_PUBLIC_CONVEX_SITE_URL=""

# Clerk + Convex: In the Clerk dashboard, create a JWT template named "convex" with:
#   - Issuer: set to your CLERK_JWT_ISSUER_DOMAIN
#   - Audience: "convex"
#   - Claims: default (sub, name, email, picture) are sufficient
# Then in the Convex dashboard, verify auth config points to the Clerk issuer domain.

# AI Provider — Convex Environment Variables
# These must be set in the Convex dashboard or via `npx convex env set`.
# They are NOT read from .env.local — Convex functions run in the Convex cloud.
#
# ZAI_API_KEY        App-level z.ai/Zhipu API key (fallback when user has no BYO key)
# GEMINI_API_KEY     App-level Google Gemini API key (fallback when user has no BYO key)
# AI_PROVIDER        Default provider: "zai" or "gemini" (default: "zai")
# AI_MODEL           Override default model for the chosen provider
# ZAI_API_ENDPOINT   Override z.ai API endpoint (default: https://open.bigmodel.cn/api/paas/v4/chat/completions)
# ENCRYPTION_KEY     AES-256-GCM encryption key for BYO user API keys (required for BYO key storage)
#
# Example:
#   npx convex env set ZAI_API_KEY "your-zai-key"
#   npx convex env set GEMINI_API_KEY "your-gemini-key"
#   npx convex env set ENCRYPTION_KEY "a-random-32-plus-char-string"
#   npx convex env set AI_PROVIDER "zai"

# File upload limits (optional, defaults shown)
# MAX_UPLOAD_SIZE_MB=50
