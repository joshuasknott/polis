generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  university    String?
  course        String?
  yearOfStudy   Int?
  role          String    @default("student")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  modules      Module[]
  sources      Source[]
  essays       Essay[]
  conversations Conversation[]
  aiProviderConnections AIProviderConnection[]
  retrievalLogs RetrievalLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Module {
  id           String   @id @default(cuid())
  userId       String
  code         String
  title        String
  description  String   @default("")
  academicYear String   @default("")
  semester     String   @default("")
  colour       String   @default("#1e3a5f")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folders     Folder[]
  assessments Assessment[]
  sources     Source[]
  essays      Essay[]
  conversations Conversation[]

  @@map("modules")
}

model Folder {
  id           String   @id @default(cuid())
  moduleId     String
  name         String
  type         String   @default("custom")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  module  Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sources Source[]

  @@map("folders")
}

model Assessment {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  type      String   @default("essay")
  dueDate   DateTime?
  weighting String?
  wordCount Int?
  status    String   @default("not_started")
  brief     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("assessments")
}

model Source {
  id            String   @id @default(cuid())
  userId        String
  moduleId      String
  folderId      String?
  title         String
  authors       String
  year          Int      @default(2026)
  type          String   @default("journal_article")
  fileName      String?
  fileType      String?
  fileSize      Int?
  storagePath   String?
  extractedText String?
  summary       String?
  keyArguments  String?
  concepts      String?
  status        String   @default("uploaded")
  errorMessage  String?
  wordCount     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  folder      Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  chunks      SourceChunk[]
  evidenceItems EvidenceItem[]

  @@map("sources")
}

model SourceChunk {
  id            String   @id @default(cuid())
  sourceId      String
  chunkIndex    Int
  text          String
  charCount     Int
  tokenEstimate Int
  pageNumber    Int?
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime @default(now())

  source        Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  evidenceItems EvidenceItem[]

  @@map("source_chunks")
}

model Essay {
  id             String   @id @default(cuid())
  userId         String
  moduleId       String
  assessmentId   String?
  title          String
  question       String?
  thesis         String?
  targetWordCount Int     @default(3000)
  status         String   @default("planning")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sections    EssaySection[]
  evidence    EvidenceItem[]
  conversations Conversation[]

  @@map("essays")
}

model EssaySection {
  id             String   @id @default(cuid())
  essayId        String
  title          String
  purpose        String?
  targetWordCount Int     @default(0)
  displayOrder   Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  essay         Essay         @relation(fields: [essayId], references: [id], onDelete: Cascade)
  evidenceItems EvidenceItem[]

  @@map("essay_sections")
}

model EvidenceItem {
  id            String   @id @default(cuid())
  essayId       String
  sectionId     String?
  sourceId      String?
  sourceChunkId String?
  claim         String
  evidenceText  String?
  explanation   String?
  citation      String?
  tags          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  essay       Essay         @relation(fields: [essayId], references: [id], onDelete: Cascade)
  section     EssaySection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  source      Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceChunk SourceChunk?  @relation(fields: [sourceChunkId], references: [id], onDelete: SetNull)

  @@map("evidence_items")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  moduleId  String?
  sourceId  String?
  essayId   String?
  title     String
  mode      String   @default("source_grounded")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module   Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  essay    Essay?    @relation(fields: [essayId], references: [id], onDelete: SetNull)
  messages ConversationMessage[]

  @@map("conversations")
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  citedChunkIds  String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_messages")
}

model AIProviderConnection {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  encryptedApiKey String?
  status          String   @default("disconnected")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_provider_connections")
}

model RetrievalLog {
  id              String   @id @default(cuid())
  userId          String
  query           String
  moduleId        String?
  sourceIds       String?
  selectedChunkIds String?
  mode            String   @default("keyword")
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("retrieval_logs")
}
